# Скопируйте в .env и заполните. Файл .env не коммитится.

# --- База данных ---
POSTGRES_PASSWORD=zhkh24_dev
DATABASE_URL=postgresql+asyncpg://zhkh24:zhkh24_dev@localhost:5432/zhkh24

# --- Сервисы ---
QDRANT_URL=http://localhost:6333
# Qdrant-сервер без Docker: data/qdrant_server/run.sh (бинарник с github.com/qdrant/qdrant/releases)
# Для разработки без Docker: встроенный Qdrant на диске (тогда QDRANT_URL не используется)
# QDRANT_PATH=./data/qdrant_local
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=zhkh24
MINIO_ROOT_PASSWORD=zhkh24_dev_secret

# --- AI ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_FALLBACKS=default

# --- Локальные модели поиска ---
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_ENABLED=true   # false — без реранкера (быстро, R@1 ниже)
# RERANK_POOL=20
# RERANK_MAX_LENGTH=384
ML_DEVICE=auto

# --- Безопасность ---
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# --- Ингест Adilet ---
ADILET_CACHE_DIR=./data/adilet_cache
ADILET_REQUEST_DELAY_SEC=3

# --- LLM ---------------------------------------------------------------------------
# anthropic   — Claude API по ключу ANTHROPIC_API_KEY (для публичного сайта)
# claude_code — локальный Claude Code `claude -p` по подписке, без ключа (только разработка у себя;
#               ANTHROPIC_API_KEY дочернему процессу не передаётся)
# none        — без LLM, демо-режим
LLM_PROVIDER=anthropic
# CLAUDE_BIN=/Users/you/.local/bin/claude   # если claude не в PATH
# CLAUDE_MODEL=                             # пусто — модель по умолчанию в Claude Code
# CLAUDE_TIMEOUT=240
# CLAUDE_MAX_PARALLEL=2
